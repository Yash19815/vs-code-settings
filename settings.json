{
  // ==========================================
  // Glenn Raya - Minimalist Theme & UI Config
  // ==========================================
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', Consolas, monospace",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": true,
  "editor.renderLineHighlight": "none",
  "editor.guides.indentation": false,
  "editor.scrollbar.vertical": "auto",
  "editor.scrollbar.horizontal": "auto",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": false,
  "editor.linkedEditing": true,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.activityBar.location": "bottom",
  "workbench.statusBar.visible": false,
  "workbench.layoutControl.enabled": false,
  "workbench.colorCustomizations": {
    "terminal.background": "#16181d",
    "panel.border": "#16181d"
}
,
  "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.3,
  // Custom CSS/JS Injection (Windows File Path Format)
  // Update the paths below to match where you saved custom-vscode.css and custom-vscode-script.js
  "vscode_custom_css.imports": [
    "file:///D:/DATA/Documents(old)/projects/vs-code/vscode-css.css",
    "file:///D:/DATA/Documents(old)/projects/vs-code/vscode-script.js"
  ],
  "vscode_custom_css.policy": true,
  "workbench.colorTheme": "React Dev Theme (dark)"
}